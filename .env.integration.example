# Use only a Supabase project/branch dedicated to homologation.
BPF_INTEGRATION_ENVIRONMENT="homologation"
BPF_INTEGRATION_SUPABASE_URL="https://SEU_PROJECT_REF_HOMOLOG.supabase.co"
BPF_INTEGRATION_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxx"
BPF_INTEGRATION_ADMIN_EMAIL="admin-homolog@example.com"
BPF_INTEGRATION_ADMIN_PASSWORD="troque-por-uma-senha-de-homologacao"

# Mutation smoke is optional for read-only validation, but required before release of Auth/Edge/write flows.
BPF_INTEGRATION_ALLOW_MUTATIONS="NO"
BPF_INTEGRATION_SERVICE_ROLE_KEY=""
BPF_INTEGRATION_INVITE_EMAIL=""
BPF_INTEGRATION_PROFILE_ID=""

# Safety override. Keep NO. The harness refuses the current production ref by default.
BPF_INTEGRATION_ALLOW_PRODUCTION="NO"
