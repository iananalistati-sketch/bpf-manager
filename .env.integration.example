# Hosted integration gate. Prefer homologation when available.
# Current project decision: official project with explicit safeguards.
BPF_INTEGRATION_ENVIRONMENT="official"
BPF_INTEGRATION_SUPABASE_URL="https://yequhfvcbwnxmqobgumu.supabase.co"
BPF_INTEGRATION_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxx"
BPF_INTEGRATION_ADMIN_EMAIL="admin@example.com"
BPF_INTEGRATION_ADMIN_PASSWORD="troque-por-uma-senha-de-teste"

# Official project requires explicit production acknowledgement even for read-only smoke.
BPF_INTEGRATION_ALLOW_PRODUCTION="YES"

# Keep mutation smoke disabled by default. Enable only for a controlled full-flow check.
BPF_INTEGRATION_ALLOW_MUTATIONS="NO"
BPF_INTEGRATION_SERVICE_ROLE_KEY=""
BPF_INTEGRATION_INVITE_EMAIL=""
BPF_INTEGRATION_PROFILE_ID=""

# Required only when BPF_INTEGRATION_ALLOW_MUTATIONS=YES on the official project.
# This extra guard must equal the exact official project ref.
BPF_INTEGRATION_PRODUCTION_MUTATION_CONFIRM=""
